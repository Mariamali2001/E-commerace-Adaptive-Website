# Local/full image that bakes in best_model_egypt_ft.h5 (~334MB).
# Build from smartshop/mood_model with the weights present:
#   docker build -f Dockerfile.local -t smartshop-mood-api .
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

COPY mood_api.py .
COPY artifacts/models/best_model_egypt_ft.h5 ./artifacts/models/best_model_egypt_ft.h5

ENV HOST=0.0.0.0
ENV PORT=8001
ENV MODEL_PATH=/app/artifacts/models/best_model_egypt_ft.h5

EXPOSE 8001

CMD ["sh", "-c", "uvicorn mood_api:app --host 0.0.0.0 --port ${PORT:-8001}"]
