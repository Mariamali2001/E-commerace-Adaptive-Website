{
  "version": "1.0",
  "description": "Adaptive UI guidelines for the React website. Generated from Notebooks 05–09, validated in Notebook 10.",
  "pipeline_order": [
    "Detect device (Desktop or Smartphone)",
    "Load global_defaults.json",
    "Merge desktop_defaults.json or mobile_defaults.json",
    "Apply persona overrides (persona_lookup.json or persona_overrides.json)",
    "Apply mood overrides (mood_lookup.json or mood_overrides.json)",
    "Apply personality nudges (trait_lookup.json or trait_modifiers.json)"
  ],
  "required_for_website": [
    "global_defaults.json",
    "desktop_defaults.json",
    "mobile_defaults.json",
    "persona_lookup.json",
    "mood_lookup.json",
    "trait_lookup.json"
  ],
  "alternative_source_files": [
    "persona_overrides.json",
    "mood_overrides.json",
    "trait_modifiers.json"
  ],
  "optional": [
    "lookup_indexes.json"
  ],
  "not_for_runtime": [
    "Use data/outputs/adaptive_engine/final_ui_configuration.json only as a simulation example, not as the live guideline source."
  ],
  "legacy_do_not_use": [
    "data/outputs/verified_guidelines.json",
    "data/outputs/profile_lookup.json"
  ]
}
